---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---

<Base>
  <h1>Hi, I'm {SITE.name}.</h1>
  <!-- TODO(David): replace with your own intro line. -->
  <p class="lede">
    I lead a software team and still write code most days. This is where I keep
    notes on what I'm building and learning.
  </p>

  <ul class="links">
    {SITE.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</Base>
